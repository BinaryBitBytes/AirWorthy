{
  "name": "airworthy",
  "version": "1.0.0",
  "description": "A full stack MERN application for FAA Inspectors, Airliners, and Aircraft Technicians.",
  "main": "server/server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "develop": "concurrently \"cd server && npm run watch\" \"cd client && npm start\"",
    "install": "npm i && cd ../client && npm i",
    "build": "cd client && npm run build",
    "seed": "node server/src/data/seed.mjs",
    "CLEAN": "rm -rf package-lock.json --verbose && rm -rf node_modules --verbose"
  },
  "keywords": [],
  "author": "Miles Colón",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@apollo/subgraph": "^2.4.9",
    "@as-integrations/express5": "^1.1.1",
    "@graphql-tools/load-files": "^7.0.0",
    "@graphql-tools/merge": "^9.0.4",
    "@graphql-tools/schema": "^10.0.4",
    "@parcel/watcher": "2.5.1",
    "@popperjs/core": "^2.11.7",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "graphql": "^16.12.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.3",
    "react-dom": "^19.1.0",
    "react-router": "7.6.3",
    "react-router-dom": "^6.26.1",
    "sass": "^1.89.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.25.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "concurrently": "^9.2.0",
    "eslint-plugin-react": "^7.35.0",
    "nodemon": "^3.1.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.17.0",
    "npm": "11.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinaryBitBytes/AirWorthy.git"
  },
  "bugs": {
    "url": "https://github.com/BinaryBitBytes/AirWorthy/issues"
  },
  "homepage": "https://github.com/BinaryBitBytes/AirWorthy#readme"
